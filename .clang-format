# .clang-format - Microsoft base + house overrides
# See StyleGuide.md section 6.1 for why each override exists.
# Verify the effective config with: clang-format --style=file --dump-config
BasedOnStyle: Microsoft     # Allman, 4-indent, no inner-paren spaces
UseTab: Always              # tabs, not spaces (base uses spaces)
TabWidth: 4
IndentWidth: 4
ColumnLimit: 0              # don't auto-wrap long lines
NamespaceIndentation: All   # indent namespace bodies one tab (base: None)
PointerAlignment: Left      # Type* p / Type& r  (base is Right - it does NOT give left)
AccessModifierOffset: -4    # public:/private: align with `class` on a whole tab
                            #   (base -2 lands mid-tab -> ugly "tab + 2 spaces")
FixNamespaceComments: false            # no `// namespace X` on the closing brace (base: true)
WrapNamespaceBodyWithEmptyLines: Never # no blank-line padding inside namespaces (base: Leave)
SpacesInLineCommentPrefix:             # leave `//comment` as typed - don't force `// comment`
  Minimum: 0                           #   (base Minimum: 1 rewrites //foo -> // foo)
  Maximum: -1
AlignTrailingComments:                 # don't align trailing comments into columns (base does);
  Kind: Never                          #   with UseTab that padding becomes tabs
  OverEmptyLines: 0
